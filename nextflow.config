/* Nextflow configuration for CeciNestPasUnePipeline. */

params {
    patients = "configs/patients.tsv"
    outdir = "results"
    monovar_script = ""
    monovar_threads = 2
    monovar_region = ""
    run_monovar = false
    run_vep_filter = false
    run_bam_qc = false

    // Filtering defaults used later by VCF processing steps.
    min_total_depth = 20
    min_alt_reads = 4
    min_vaf = 0.0
    max_population_af = 0.001
    keep_cosmic = true

    // Future VEP settings.
    vep_cache = "${System.getenv('HOME')}/.vep"
    genome = "GRCh38"
    vep_species = "homo_sapiens"
    vep_cache_version = "115"
    vep_fasta = ""
    vep_forks = 2
    vep_buffer_size = 5000
    vep_sites_per_chunk = 5000

    // Sarek-like optional BAM-level QC. Full BAM coverage can be expensive.
    mosdepth_threads = 2
    mosdepth_by = ""
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.dot"
}
