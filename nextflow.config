/* Nextflow configuration for CeciNestPasUnePipeline. */

params {
    patients = "configs/patients.tsv"
    outdir = "results"
    monovar_script = ""
    monovar_threads = 2
    monovar_region = ""
    monovar_targets_bed = ""
    monovar_background_ctc_count = 5
    monovar_background_seed = 13
    run_monovar = false
    run_sccaller = false
    run_external_callers = false
    run_comparison = false
    run_caller_scorecard = false
    run_delsieve_prep = false
    run_delsieve = false
    run_delsieve_from_existing = false
    run_delsieve_tree_annotator = true
    run_vep_filter = false
    run_snv_report = true
    run_final_report = true
    final_report_top_variants = 200
    final_report_rarefaction_iterations = 200
    run_bam_qc = false
    caller_vcfs = "configs/caller_vcfs.tsv"
    tissue_vcfs = ""
    enable_weblog = false
    weblog_url = "http://localhost:8605"

    // Filtering defaults used later by VCF processing steps.
    min_total_depth = 20
    min_alt_reads = 4
    min_vaf = 0.0
    max_population_af = 0.001
    keep_cosmic = true
    delsieve_min_ctc_support = 2
    delsieve_callers = "all"
    delsieve_min_base_quality = 0
    delsieve_min_mapping_quality = 0
    delsieve_existing_long_table = ""
    delsieve_applauncher = "applauncher"
    delsieve_beast = "beast"
    delsieve_treeannotator = "applauncher"
    delsieve_version_file = ""
    delsieve_template_stage1 = ""
    delsieve_threads = 4
    delsieve_datatype = 1
    delsieve_missing_threshold = 1
    delsieve_sample_cells = 0
    delsieve_sample_loci = 0
    delsieve_ignore_sex = false
    delsieve_beast_extra_args = ""
    delsieve_datacollector_extra_args = ""
    delsieve_tree_burnin = 10
    delsieve_tree_heights = "median"
    run_delsieve_variant_caller = true
    delsieve_variant_burnin = 10
    delsieve_variant_estimates = "median"
    delsieve_variant_extra_args = ""
    run_delsieve_tree_png = true
    delsieve_figtree = "figtree"
    delsieve_figtree_extra_args = ""
    run_delsieve_gene_annotator = true
    delsieve_mutation_map = ""
    delsieve_geneannotator_subst = 1
    delsieve_mutation_map_annovar = false
    delsieve_annovar_separator = 0
    delsieve_annovar_filter_col = -1
    delsieve_annovar_filter_keywords = ""
    delsieve_gene_filter = ""
    delsieve_gene_filter_sep = 0
    delsieve_gene_filter_col = 0
    delsieve_geneannotator_extra_args = ""
    sccaller_script = ""
    sccaller_cpu = 8
    sccaller_bias = 0.75
    sccaller_engine = "samtools"
    sccaller_mode = "external_bulk"
    sccaller_hsnp_vcf = ""

    // Future VEP settings.
    vep_cache = "${System.getenv('HOME')}/.vep"
    genome = "GRCh38"
    vep_species = "homo_sapiens"
    vep_cache_version = "115"
    vep_fasta = ""
    vep_forks = 2
    vep_buffer_size = 5000
    vep_sites_per_chunk = 5000

    // Sarek-like optional BAM-level QC. Full BAM coverage can be expensive.
    mosdepth_threads = 2
    mosdepth_by = ""
    breadth_thresholds = "1,10,20"
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.dot"
}

weblog {
    enabled = params.enable_weblog
    url = params.weblog_url
}
